APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# Use "mock" to run the complete P0 flow without spending tokens.
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://your-provider.example.com/v1
MODEL_API_KEY=
MODEL_NAME=your-model-name
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# Prices are configurable because providers charge different rates.
MODEL_INPUT_PRICE_PER_MILLION=0
MODEL_OUTPUT_PRICE_PER_MILLION=0
